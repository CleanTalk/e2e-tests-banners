BANNERS_TESTS_URL=http://localhost:8080
BANNERS_TESTS_AUTH_LOGIN=admin
BANNERS_TESTS_AUTH_PASS=password
BANNERS_TESTS_API_KEY_REGULAR=
BANNERS_TESTS_API_KEY_REVIEW=
BANNERS_TESTS_API_KEY_TRIAL_EXPIRED=
BANNERS_TESTS_API_KEY_PAID_EXPIRED=
BANNERS_TESTS_REGULAR_TIMEOUT=20
# yes = headless CI; no = visible Firefox
BANNERS_TESTS_HEADLESS=no
# seconds to wait after each page check in a visible browser
