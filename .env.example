BANNERS_TESTS_INJECT_NOTICES=yes
BANNERS_TESTS_DB_HOST=127.0.0.1
BANNERS_TESTS_DB_PORT=3310
BANNERS_TESTS_DB_NAME=wordpress
BANNERS_TESTS_DB_USER=wordpress
BANNERS_TESTS_DB_PASSWORD=wordpress
